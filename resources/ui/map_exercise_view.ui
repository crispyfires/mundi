<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="MapExerciseView" parent="AdwNavigationPage">
    <property name="title">Exercise</property>
    <property name="child">
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar">
            <property name="title-widget">
              <object class="GtkBox">
                <property name="spacing">12</property>
                <property name="halign">center</property>
                <child>
                  <object class="AdwWindowTitle" id="header_title">
                    <property name="title">Exercise</property>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="timer_label">
                    <property name="visible">false</property>
                    <style>
                      <class name="title"/>
                    </style>
                  </object>
                </child>
              </object>
            </property>
            <child type="end">
              <object class="GtkButton" id="quiz_button">
                <property name="label" translatable="yes">Start Quiz</property>
                <style>
                  <class name="suggested-action"/>
                </style>
              </object>
            </child>
          </object>
        </child>
        <property name="content">
          <object class="GtkBox" id="content_box">
            <property name="orientation">vertical</property>
            <property name="spacing">12</property>
            <property name="margin-start">12</property>
            <property name="margin-end">12</property>
            <property name="margin-top">12</property>
            <property name="margin-bottom">12</property>
            <child>
              <object class="GtkLabel" id="discovery_label">
                <property name="halign">center</property>
                <property name="label"> </property>
                <style>
                  <class name="title-2"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="prompt_label">
                <property name="halign">center</property>
                <property name="visible">false</property>
                <style>
                  <class name="title-2"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="attempts_label">
                <property name="halign">center</property>
                <property name="visible">false</property>
                <style>
                  <class name="dim-label"/>
                </style>
              </object>
            </child>
            <!-- MapWidget inserted here programmatically -->
            <child>
              <object class="QuizResultsView" id="quiz_results_view">
                <property name="visible">false</property>
              </object>
            </child>
          </object>
        </property>
      </object>
    </property>
  </template>
</interface>
